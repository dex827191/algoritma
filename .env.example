# Cloudflare Zero Trust > Networks > Tunnels > tunnel token
CF_TOKEN=PASTE_CLOUDFLARE_TUNNEL_TOKEN_HERE

# Public HTTP ingress through Railway to the wrapper
WRAPPER_HOST=0.0.0.0
WRAPPER_PORT=8080
NGINX_HOST=127.0.0.1
NGINX_PORT=8082

# Internal Node panel/API port (do not expose publicly)
PANEL_PORT=8081

# Port shown in generated VLESS/VMess/Trojan links behind Cloudflare
CFPORT=443
