# Domain hostname routed by your Cloudflare Named Tunnel ingress
DOMAIN=node.example.com

# Cloudflare Named Tunnel token (leave empty to disable tunnel)
CF_TOKEN=

PANEL_PORT=3000
WRAPPER_PORT=8080
NGINX_PORT=8081
SSH_PORT=22
UDPGW_PORT=7300
UDPGW_MAX_CLIENTS=1000
# Optional stable Xray client UUID; otherwise generated by the API for config links only
UUID=
