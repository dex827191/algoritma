# Panel UI/API — Railway domain target port 2053
PANEL_PORT=2053

# Cloudflare Tunnel SSH + Xray origin: http://localhost:8080
WRAPPER_PORT=8080

# Cloudflare Named Tunnel token (isi token BARU setelah token lama di-rotate)
CF_TOKEN=

# Domain publik untuk SSH WebSocket dan Xray melalui Cloudflare Tunnel
SSH_DOMAIN=emile.anomali.de5.net
XRAY_DOMAIN=emile.anomali.de5.net

# DOMAIN lama tetap didukung sebagai fallback; boleh dikosongkan
DOMAIN=

SSH_PORT=22
UDPGW_PORT=7300
UDPGW_MAX_CLIENTS=1000
# Optional stable Xray client UUID; otherwise generated by the API for config links only
UUID=
